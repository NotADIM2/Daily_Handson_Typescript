{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // src/pgmN.ts  ->  dist/pgmN.js  (never put output next to the source)
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    // Node.js globals and modules (console, process, readline, ...) from @types/node
    "types": ["node"],

    // Other Outputs
    "sourceMap": false,
    "declaration": false,
    "declarationMap": false,

    // If there is any type error, write no .js at all, so a broken program can't be run
    "noEmitOnError": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Extra-strict options (off: they reject ordinary textbook code)
    // "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    // Treat every file as its own module, so pgm3.ts and pgm4.ts can both declare `let num`
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  // Only compile files inside src/
  "include": ["src"]
}
